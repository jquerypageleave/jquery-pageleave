# Port des Webservers
PORT=3000

# Pfad zur SQLite-Datenbank (Ordner wird automatisch angelegt)
DB_PATH=./data/patienten.sqlite

# Optionaler Passwortschutz für die Oberfläche (HTTP Basic Auth).
# Leer lassen, um ohne Login zu arbeiten (nur für rein lokale Nutzung empfohlen).
APP_USER=praxis
APP_PASSWORD=

# Google-Kalender-Anbindung (OAuth 2.0 Client-ID vom Typ "Webanwendung")
# Anleitung: siehe README.md, Abschnitt "Google Kalender verbinden"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Welcher Kalender soll verwendet werden? "primary" = Hauptkalender des Google-Kontos
GOOGLE_CALENDAR_ID=primary

# Zeitzone für Termine
TIMEZONE=Europe/Berlin
